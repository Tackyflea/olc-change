<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Root" style="flex-grow: 1; width: 100%; height: 100%;">
        <ui:VisualElement name="Header" style="height: 20%; background-color: rgba(255, 84, 84, 0); max-height: 150px; opacity: 1;">
            <ui:VisualElement style="flex-grow: 1; background-color: rgb(255, 255, 255); aspect-ratio: 5; height: 46%; position: absolute;">
                <ui:VisualElement style="flex-grow: 1; align-items: flex-start; justify-content: flex-start; align-self: auto; align-content: auto; flex-direction: row; -unity-text-align: middle-left; top: 10px; left: 10px;">
                    <ui:Label text="Coins:" name="CoinsID" style="font-size: 30px;"/>
                    <ui:Label text="0" name="CoinsValue" style="font-size: 30px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Main" style="flex-grow: 1; background-color: rgba(255, 255, 255, 0);"/>
    </ui:VisualElement>
</ui:UXML>
